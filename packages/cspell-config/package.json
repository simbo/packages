{
  "name": "@simbo/cspell-config",
  "description": "Simbo's shared CSpell configuration.",
  "version": "2.2.0",
  "keywords": [
    "cspell",
    "config",
    "configuration",
    "spelling",
    "spellcheck",
    "dictionary",
    "lint",
    "shared",
    "preset"
  ],
  "author": "Simon Lepel <simbo@simbo.de> (https://simbo.de/)",
  "license": "MIT",
  "homepage": "https://github.com/simbo/packages/tree/main/packages/cspell-config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simbo/packages.git",
    "directory": "packages/cspell-config"
  },
  "bugs": "https://github.com/simbo/packages/issues",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "CHANGELOG.md",
    "dictionaries",
    "dist",
    "LICENSE.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "pnpm run check:eslint && pnpm run check:types",
    "check:eslint": "eslint --config ./eslint.config.ts --max-warnings 0",
    "check:types": "tsc --noEmit",
    "clean": "pnpm run clean:dist && pnpm run clean:coverage && pnpm run clean:turbo && pnpm run clean:node_modules",
    "clean:dist": "rm -rf dist",
    "clean:node_modules": "rm -rf node_modules",
    "clean:turbo": "rm -rf .turbo",
    "clean:coverage": "rm -rf coverage",
    "fix:eslint": "pnpm run check:eslint --fix",
    "test": "vitest run --coverage",
    "test:ui": "pnpm run test:watch --ui",
    "test:watch": "vitest dev --coverage"
  },
  "peerDependencies": {
    "cspell": "^9 || ^10"
  },
  "devDependencies": {
    "@cspell/cspell-types": "^10.5.2",
    "@simbo/eslint-config": "workspace:*",
    "@simbo/tsconfig": "workspace:*",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/ui": "^5.1.1",
    "cspell": "^10.5.2",
    "eslint": "^10.15.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
