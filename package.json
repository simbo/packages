{
  "name": "packages",
  "description": "A monorepo for my packages.",
  "version": "0.0.0",
  "private": true,
  "author": "Simon Lepel <simbo@simbo.de> (https://simbo.de)",
  "license": "MIT",
  "homepage": "https://github.com/simbo/packages",
  "bugs": "https://github.com/simbo/packages/issues",
  "repository": "github:simbo/packages",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "workspaces": [
    "packages/*",
    "changelog"
  ],
  "type": "module",
  "scripts": {
    "check": "turbo run //#check:eslint //#check:types && pnpm run check:format && pnpm run check:boundaries && pnpm run check:spelling",
    "check:boundaries": "turbo boundaries",
    "check:eslint": "eslint --config ./eslint.config.ts --max-warnings 0 '*.ts' '*.js' 'scripts/*.js'",
    "check:format": "pnpm run x:prettier --check .",
    "check:spelling": "pnpm run x:cspell",
    "check:types": "tsc --noEmit",
    "clean": "pnpm run clean:coverage && pnpm run clean:docs && pnpm run clean:turbo && pnpm run clean:node_modules",
    "clean:coverage": "rm -rf coverage",
    "clean:docs": "rm -rf docs",
    "clean:node_modules": "rm -rf node_modules",
    "clean:turbo": "rm -rf .turbo",
    "docs": "pnpm run each:build && pnpm run docs:typedoc",
    "docs:typedoc": "typedoc && cp ./typedoc-index.md ./docs/README.md",
    "each:build": "turbo run build",
    "each:check": "turbo run check:eslint check:types check:pack --filter='!//'",
    "each:clean": "pnpm run each:clean:coverage && pnpm run each:clean:dist && pnpm run each:clean:turbo && pnpm run each:clean:node_modules",
    "each:clean:coverage": "pnpm -r exec rm -rf coverage",
    "each:clean:dist": "pnpm -r exec rm -rf dist",
    "each:clean:node_modules": "pnpm -r exec rm -rf node_modules",
    "each:clean:turbo": "pnpm -r exec rm -rf .turbo",
    "each:test": "turbo run test",
    "fix:eslint": "pnpm run check:eslint --fix",
    "fix:format": "pnpm run x:prettier --write .",
    "ncu:latest": "ncu --interactive --target latest --reject='/^(@types/node|typescript)$/'",
    "ncu:minor": "ncu --interactive --target minor",
    "ncu:patch": "ncu --interactive --target patch",
    "packages-list": "turbo run build --filter=@simbo/monorepo-packages-list-cli && ./packages/monorepo-packages-list-cli/dist/cli.js",
    "preflight": "pnpm install --frozen-lockfile && pnpm run preflight:checks && pnpm run preflight:repository && pnpm run packages-list && echo 'CvCfn6IgG1sxOzMybUFsbCBDaGVja3MgUGFzc2VkIRtbMG0K' | base64 --decode",
    "preflight:checks": "turbo run build check:eslint check:types check:pack --output-logs=errors-only --continue=dependencies-successful",
    "preflight:repository": "turbo run //#test //#docs:typedoc //#check:format //#check:spelling //#check:boundaries --output-logs=errors-only --continue",
    "prepare": "husky",
    "publish-initial": "node scripts/publish-release.js",
    "serve:coverage": "npx --yes http-server -c-1 ./coverage",
    "serve:docs": "npx --yes http-server -c-1 ./docs",
    "test": "vitest run --coverage",
    "test:ui": "pnpm run test:watch --ui",
    "test:watch": "vitest dev --coverage",
    "x:cspell": "turbo run build --filter=@simbo/cspell-config && cspell",
    "x:prettier": "turbo run build --filter=@simbo/prettier-config && prettier"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@simbo/commitlint-config": "workspace:*",
    "@simbo/cspell-config": "workspace:*",
    "@simbo/eslint-config": "workspace:*",
    "@simbo/prettier-config": "workspace:*",
    "@simbo/tsconfig": "workspace:*",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/ui": "^5.1.1",
    "cspell": "^10.5.2",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typedoc": "^0.28.20",
    "typedoc-github-theme": "^0.4.0",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
