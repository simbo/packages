{
  "$schema": "https://turbo.build/schema.json",
  "noUpdateNotifier": true,
  "globalDependencies": [".npmrc", ".nvmrc", "pnpm-workspace.yaml"],
  "boundaries": {
    "tags": {
      "config": {
        "dependencies": {
          "allow": ["config"]
        }
      },
      "core": {
        "dependencies": {
          "allow": ["config"]
        }
      },
      "lib": {
        "dependencies": {
          "allow": ["config", "core", "lib"]
        }
      },
      "cli": {
        "dependencies": {
          "allow": ["config", "core", "lib"]
        },
        "dependents": {
          "deny": ["config", "core", "lib", "cli", "meta"]
        }
      },
      "meta": {
        "dependents": {
          "deny": ["config", "core", "lib", "cli", "meta"]
        }
      }
    }
  },
  "tasks": {
    "//#check:boundaries": {
      "cache": false
    },
    "//#check:eslint": {
      "dependsOn": ["^build", "@simbo/monorepo-packages-list-cli#build", "@simbo/monorepo-utils#build"],
      "inputs": ["*.ts", "*.js", "scripts/**", "tsconfig.json", "package.json"]
    },
    "//#check:format": {
      "cache": false
    },
    "//#check:spelling": {
      "cache": false
    },
    "//#check:types": {
      "dependsOn": ["^build", "@simbo/monorepo-packages-list-cli#build", "@simbo/monorepo-utils#build"],
      "inputs": ["*.ts", "*.js", "scripts/**", "tsconfig.json", "package.json"]
    },
    "//#docs:typedoc": {
      "cache": false
    },
    "//#test": {
      "cache": false
    },
    "build": {
      "dependsOn": ["clean:dist", "^build"],
      "outputs": ["dist/**"],
      "outputLogs": "new-only"
    },
    "check": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "check:eslint": {
      "dependsOn": ["^build"]
    },
    "check:types": {
      "dependsOn": ["build"]
    },
    "clean": {
      "cache": false,
      "outputLogs": "none"
    },
    "clean:dist": {
      "cache": false,
      "outputLogs": "none"
    },
    "clean:turbo": {
      "cache": false,
      "outputLogs": "none"
    },
    "clean:node_modules": {
      "cache": false,
      "outputLogs": "none"
    },
    "clean:coverage": {
      "cache": false,
      "outputLogs": "none"
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
